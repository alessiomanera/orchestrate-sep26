# Copy this file to .env and fill in the values. .env is gitignored, never commit it.
#   cp .env.example .env
#
# The solution reads every secret from the environment. Nothing here is committed
# with a real value, and no key is ever hardcoded in code/.

# ---------------------------------------------------------------------------
# Model providers
# ---------------------------------------------------------------------------
# At least one is required. The solution only calls a model for the 16 dataset
# images and the 215 messages; the 250 request decisions are pure Python.

# Google AI Studio, https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic, https://console.anthropic.com/settings/keys  (optional)
ANTHROPIC_API_KEY=

# Model ids. gemini-flash-latest is the floating alias; a pinned id is preferred
# because the run must be reproducible and an alias can move under you mid build.
VISION_MODEL=gemini-3.8-flash
TEXT_MODEL=gemini-3.8-flash

# ---------------------------------------------------------------------------
# Run behaviour
# ---------------------------------------------------------------------------
# Deterministic output is graded, keep this at 0.
MODEL_TEMPERATURE=0

# Cache extracted image and message facts so a re-run costs nothing and the
# token report stays reproducible.
CACHE_DIR=.cache

# ---------------------------------------------------------------------------
# Transcript redaction
# ---------------------------------------------------------------------------
# log.txt is submitted to the organizers. Any literal string listed here is
# replaced with [REDACTED] before it is written, so private paths and note names
# never reach the graded transcript. Comma separated, case insensitive, both
# slash directions are handled automatically.
#
# Put your own private paths and folder names here. Leave it empty and only
# API key shapes are scrubbed.
#
# Example:
#   TRANSCRIPT_REDACT=C:\path\to\private\notes,MyNotesFolder,ProjectCodename
TRANSCRIPT_REDACT=
